<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:coins="clr-namespace:WalletWasabi.Fluent.ViewModels.Wallets.Coins"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="coins:CoinViewModel"
             x:CompileBindings="True"
             x:Class="WalletWasabi.Fluent.Views.CoinControl.Core.Cells.IndicatorsCellView">

  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="3" Margin="20 0 20 0">

    <Panel>
      <!-- Confirmed -->
      <PathIcon IsVisible="{Binding IsConfirmed}"
                Data="{StaticResource checkmark_filled}"
                Foreground="{DynamicResource TextControlForeground}"
                Opacity="0.6"
                Height="11"
                ToolTip.Tip="{Binding ConfirmationStatus}" />
      <!-- Pending -->
      <PathIcon IsVisible="{Binding !IsConfirmed}"
                Data="{StaticResource clock_regular}"
                Height="14"
                Opacity="0.3"
                ToolTip.Tip="Pending" />
    </Panel>

    <!-- In a coinjoin round. Which coins the next round gets is told by the ticks of the Coins tab, not by a sign here. -->
    <PathIcon IsVisible="{Binding IsCoinjoining}"
              Data="{StaticResource wallet_action_coinjoin}"
              Foreground="{DynamicResource SystemAccentColor}"
              Height="15"
              ToolTip.Tip="Coinjoining" />

    <!-- Banned. Only a coin that was given to a round has to do with that. -->
    <PathIcon Data="{StaticResource warning_circle}"
              Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
              Height="14"
              ToolTip.Tip="{Binding BannedUntilUtcToolTip}">
      <PathIcon.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="IsBanned"/>
          <Binding Path="IsSelectedForCoinJoin"/>
        </MultiBinding>
      </PathIcon.IsVisible>
    </PathIcon>

  </StackPanel>
</UserControl>
