<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:searchBar="clr-namespace:WalletWasabi.Fluent.Views.SearchBar"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shell="clr-namespace:WalletWasabi.Fluent.Views.Shell"
             mc:Ignorable="d" d:DesignWidth="1000"
             x:Class="WalletWasabi.Fluent.Views.Shell.TitleBar"
             x:Name="UserControl">

  <UserControl.Styles>
    <Style Selector="Panel#TitlePanel">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.100" />
          <TransformOperationsTransition Duration="0:0:0.175" Property="RenderTransform"
                                         Easing="{StaticResource FluentEasing}" />
        </Transitions>
      </Setter>
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="translateX(0px)" />
    </Style>
    <Style Selector="Panel#TitlePanel.minWidth">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="translateX(-20px)" />
    </Style>

  </UserControl.Styles>

  <UserControl.Resources>

    <DataTemplate x:Key="Logo">
      <Viewbox Height="18" Width="18" IsHitTestVisible="False">
        <Image Source="{DynamicResource app_logo_dynamic}" />
      </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="Title">
      <StackPanel IsHitTestVisible="False" x:Name="Title"
                  VerticalAlignment="Center"
                  TextElement.FontFamily="{StaticResource LogoTextFont}"
                  Classes="h7"
                  TextElement.FontWeight="Light" Orientation="Horizontal" ClipToBounds="False">
        <TextBlock Text="BLACK" Foreground="{DynamicResource LogoFixedForegroundColor}" />
        <TextBlock Text="." Foreground="{DynamicResource LogoAccentColor}" />
        <TextBlock Text="HOLE" Foreground="{DynamicResource LogoFixedForegroundColor}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="SearchBar">
      <searchBar:SearchBar DataContext="{Binding #UserControl.DataContext.SearchBar}" VerticalAlignment="Stretch"
                           HorizontalAlignment="Stretch"
                           Margin="5" />
    </DataTemplate>

    <DataTemplate x:Key="Layout">
      <Grid DataContext="{Binding $parent.DataContext}">

        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="3*" MaxWidth="400" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- The logo starts where the content of the pages starts. -->
        <ContentControl ContentTemplate="{StaticResource Logo}" HorizontalAlignment="Left" Margin="31 0 0 0" />

        <ContentControl Grid.Column="1" ContentTemplate="{StaticResource SearchBar}" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6" Margin="0 0 8 0">
          <shell:NetworkBadge VerticalAlignment="Center" />
          <Button Classes="transparentFunction" Padding="7" VerticalAlignment="Center"
                  Command="{Binding OpenDataFolderCommand}"
                  ToolTip.Tip="Data Folder">
            <PathIcon Data="{StaticResource folder_regular}" Width="18" Height="18" Opacity="0.6" />
          </Button>
          <Button Classes="transparentFunction" Padding="7" VerticalAlignment="Center"
                  Command="{Binding SettingsPage.OpenCommand}"
                  ToolTip.Tip="Settings">
            <PathIcon Data="{StaticResource nav_settings_24_regular}" Width="18" Height="18" Opacity="0.6" />
          </Button>
        </StackPanel>

      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Panel>
    <Border x:Name="Hitbox" Background="Transparent" IsVisible="{Binding #UserControl.SearchResultsPopup.IsOpen}" />
    <ContentControl
      ContentTemplate="{StaticResource Layout}" />
  </Panel>
</UserControl>
