<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shell="clr-namespace:WalletWasabi.Fluent.Views.Shell"
             xmlns:viewModels="clr-namespace:WalletWasabi.Fluent.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000"
             x:DataType="viewModels:MainViewModel"
             x:CompileBindings="True"
             x:Class="WalletWasabi.Fluent.Views.Shell.TitleBar">

  <Grid Height="42" ColumnDefinitions="Auto,*">

    <!-- The logo starts where the content of the pages starts. It is the plain one: the detailed one would blur at this size. -->
    <Viewbox Grid.Column="0" Height="18" Width="18" Margin="31 0 12 0" IsHitTestVisible="False">
      <Image Source="{DynamicResource app_logo_small}" />
    </Viewbox>

    <!-- In a window that is too narrow for all of it, the texts give way from the left on, so that the buttons stay. -->
    <RightAlignedRow Grid.Column="1" Spacing="6" Margin="0 0 8 0">
      <!-- The fee rate for a quick confirmation, once the node gave its estimates. -->
      <TextBlock Text="{Binding FeeRate}"
                 IsVisible="{Binding FeeRate, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 VerticalAlignment="Center" Margin="0 0 12 0" Opacity="0.8" />
      <!-- What the wallet owns, once it is opened: all of it in one amount. -->
      <TextBlock Text="{Binding Balance}"
                 IsVisible="{Binding Balance, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 VerticalAlignment="Center" Margin="0 0 12 0" Opacity="0.8" />
      <!-- The height of the chain, until a wallet is opened. -->
      <TextBlock Text="{Binding ChainHeight}"
                 IsVisible="{Binding IsChainHeightVisible}"
                 VerticalAlignment="Center" Margin="0 0 6 0" Opacity="0.8" />
      <!-- How far the wallet is with the blocks of the node. The tooltip tells what it is doing. -->
      <TextBlock Text="{Binding SyncProgress}"
                 IsVisible="{Binding IsSyncProgressVisible}"
                 ToolTip.Tip="{Binding SyncStatus}"
                 Background="Transparent"
                 VerticalAlignment="Center" Margin="0 0 6 0" Opacity="0.8" />
      <shell:NetworkBadge VerticalAlignment="Center" />
      <Button Classes="transparentFunction" Padding="7" VerticalAlignment="Center"
              Command="{Binding OpenDataFolderCommand}"
              ToolTip.Tip="Data Folder">
        <PathIcon Data="{StaticResource folder_regular}" Width="18" Height="18" Opacity="0.6" />
      </Button>
      <Button Classes="transparentFunction" Padding="7" VerticalAlignment="Center"
              Command="{Binding SettingsPage.OpenCommand}"
              ToolTip.Tip="Settings">
        <PathIcon Data="{StaticResource nav_settings_24_regular}" Width="18" Height="18" Opacity="0.6" />
      </Button>
    </RightAlignedRow>

  </Grid>
</UserControl>
