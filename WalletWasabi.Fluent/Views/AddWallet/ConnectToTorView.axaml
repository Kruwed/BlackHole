<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WalletWasabi.Fluent.ViewModels.AddWallet"
             xmlns:converters="using:WalletWasabi.Fluent.Converters"
             mc:Ignorable="d" d:DesignWidth="428" d:DesignHeight="371"
             x:DataType="vm:ConnectToTorViewModel"
             x:CompileBindings="True"
             x:Class="WalletWasabi.Fluent.Views.AddWallet.ConnectToTorView">
  <UserControl.Resources>
    <converters:ConnectionStatusBrushConverter x:Key="BoolToConnectionStatusBrush"
                                               SuccessBrush="{StaticResource PositiveBrush}"
                                               FailureBrush="{StaticResource DismissColor}" />
  </UserControl.Resources>
  <ContentArea Title="{Binding Title}"
               Caption="See to it that Black Hole is connected to Tor."
               EnableCancel="{Binding EnableCancel}"
               EnableBack="{Binding EnableBack}"
               EnableNext="True" NextContent="{Binding NextLabel}"
               IsBusy="{Binding IsBusy}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Width="420">
      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
      <TextBlock Text="How Tor is used is chosen in the settings, on the Tor tab. The gear in the top right corner opens them."
                 IsVisible="{Binding IsTorASetting}"
                 TextWrapping="Wrap"
                 Opacity="0.6" />

      <!-- How it stands with the connection. While it is being made the words have the colour of the others; afterwards they tell by their colour how it went.
           The room for them is always there, so that nothing moves when they appear. -->
      <Panel MinHeight="40" Margin="0 10 0 0" IsVisible="{Binding IsTorUsed}">
        <TextBlock Text="{Binding StatusMessage}"
                   IsVisible="{Binding IsConnecting}"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding StatusMessage}"
                   IsVisible="{Binding !IsConnecting}"
                   Foreground="{Binding IsConnected, Converter={StaticResource BoolToConnectionStatusBrush}}"
                   TextWrapping="Wrap" />
      </Panel>
    </StackPanel>
  </ContentArea>
</UserControl>
