<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WalletWasabi.Fluent.ViewModels.AddWallet"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d" d:DesignWidth="428" d:DesignHeight="371"
             x:DataType="vm:AddWalletPageViewModel"
             x:CompileBindings="True"
             x:Class="WalletWasabi.Fluent.Views.AddWallet.AddWalletPageView">
  <ContentArea Title="{Binding Title}"
                 EnableCancel="{Binding EnableCancel}"
                 EnableBack="{Binding EnableBack}"
                 IsBusy="{Binding IsBusy}"
                 EnableNext="False">
    <Grid Width="530" MaxHeight="350" ColumnDefinitions="*,*" RowDefinitions="*,*">
      <Grid.Styles>
        <Style Selector="TileButton">
          <Setter Property="Cursor" Value="Hand" />
          <Setter Property="Width">
            <Setter.Value>
              <system:Double>NaN</system:Double>
            </Setter.Value>
          </Setter>
          <Setter Property="Height">
            <Setter.Value>
              <system:Double>NaN</system:Double>
            </Setter.Value>
          </Setter>
          <Setter Property="Margin" Value="10" />
          <Setter Property="Template">
            <ControlTemplate>
              <Border x:Name="PART_Border"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      Background="{TemplateBinding Background}"
                      CornerRadius="10">
                <Grid RowDefinitions="5* 4*">
                  <Panel Grid.Row="0">
                    <PathIcon x:Name="PART_Icon"
                              Data="{TemplateBinding Icon}"
                              Width="{TemplateBinding IconSize}"
                              Height="{TemplateBinding IconSize}" />
                  </Panel>
                  <TextBlock Grid.Row="1" x:Name="PART_Text"
                             DockPanel.Dock="Bottom"
                             Text="{TemplateBinding Text}"
                             Foreground="{TemplateBinding Foreground}" />
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter>
        </Style>
        <Style Selector="TileButton /template/ PathIcon#PART_Icon">
          <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="TileButton:disabled">
          <Setter Property="Opacity" Value="0.4" />
        </Style>
      </Grid.Styles>

      <!-- The wallet -->
      <TileButton Grid.Row="0" Grid.Column="0" Text="Create a new wallet"
                    Classes="action bottomtext"
                    Icon="{StaticResource add_regular}"
                    IsDefault="True"
                    Command="{Binding CreateWalletCommand}" />

      <TileButton Grid.Row="0" Grid.Column="1" Text="Recover a wallet"
                    Icon="{StaticResource recover_arrow_right_regular}"
                    Classes="bottomtext"
                    Command="{Binding RecoverWalletCommand}" />

      <!-- The node that the wallet works with -->
      <!-- A placeholder: it does nothing yet, so it cannot be used. -->
      <TileButton Grid.Row="1" Grid.Column="0" Text="Create a full node"
                    Icon="{StaticResource cube_multiple_regular}"
                    Classes="bottomtext"
                    IsEnabled="False" />

      <TileButton Grid.Row="1" Grid.Column="1" Text="Connect to a full node"
                    Icon="{StaticResource connector_regular}"
                    Classes="bottomtext"
                    Command="{Binding ConnectToFullNodeCommand}" />
    </Grid>
  </ContentArea>
</UserControl>
