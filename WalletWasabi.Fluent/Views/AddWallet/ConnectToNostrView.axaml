<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WalletWasabi.Fluent.ViewModels.AddWallet"
             xmlns:converters="using:WalletWasabi.Fluent.Converters"
             mc:Ignorable="d" d:DesignWidth="428" d:DesignHeight="371"
             x:DataType="vm:ConnectToNostrViewModel"
             x:CompileBindings="True"
             x:Class="WalletWasabi.Fluent.Views.AddWallet.ConnectToNostrView">
  <UserControl.Resources>
    <converters:ConnectionStatusBrushConverter x:Key="BoolToConnectionStatusBrush"
                                               SuccessBrush="{StaticResource PositiveBrush}"
                                               FailureBrush="{StaticResource DismissColor}" />
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBox /template/ DataValidationErrors">
      <Setter Property="MinHeight" Value="25" />
    </Style>
  </UserControl.Styles>
  <ContentArea Title="{Binding Title}"
               Caption="Name the Nostr relays that Black Hole connects to."
               EnableCancel="{Binding EnableCancel}"
               EnableBack="{Binding EnableBack}"
               EnableNext="True" NextContent="{Binding NextLabel}"
               IsBusy="{Binding IsBusy}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Width="420">
      <Label Content="Nostr relays, one address on a line:" Target="TbRelays" />
      <!-- Enter starts a new line here, so the relays are connected to with the button. -->
      <TextBox Name="TbRelays"
               Text="{Binding Relays}"
               Height="100"
               AcceptsReturn="True" TextWrapping="NoWrap"
               Classes="monoSpaced"
               Watermark="wss://relay.example"
               IsEnabled="{Binding !IsReadOnly}"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
        <Interaction.Behaviors>
          <FocusOnAttachedBehavior />
        </Interaction.Behaviors>
      </TextBox>
      <TextBlock Text="Your offer as a market maker is posted to these relays, through Tor unless Tor is turned off. Connecting sends them nothing: it only finds out whether they answer."
                 TextWrapping="Wrap"
                 Opacity="0.6" />

      <!-- What the relays answered to the last attempt. The room for it is always there, so that nothing moves when it appears. -->
      <TextBlock Text="{Binding StatusMessage}"
                 Foreground="{Binding IsConnected, Converter={StaticResource BoolToConnectionStatusBrush}}"
                 TextWrapping="Wrap"
                 MinHeight="60"
                 Margin="0 10 0 0" />

      <InfoMessage Foreground="{StaticResource WarningMessageForeground}"
                   IsVisible="{Binding IsReadOnly}"
                   Margin="0 10 0 0">
        <TextBlock Text="The relays were given on the command line or in the environment when Black Hole was started, so they cannot be changed here."
                   TextWrapping="Wrap" />
      </InfoMessage>
    </StackPanel>
  </ContentArea>
</UserControl>
