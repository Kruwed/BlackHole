<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="using:WalletWasabi.Fluent.ViewModels.Settings"
             xmlns:conv="using:WalletWasabi.Fluent.Converters"
             xmlns:basemodels="using:WalletWasabi.Models"
             mc:Ignorable="d" d:DesignWidth="650"
             x:Class="WalletWasabi.Fluent.Views.Settings.ConnectionsSettingsTabView"
             x:CompileBindings="True"
             x:DataType="settings:ConnectionsSettingsTabViewModel">
  <UserControl.Resources>
    <conv:ConnectionStatusBrushConverter x:Key="BoolToConnectionStatusBrush"
                                         SuccessBrush="{StaticResource PositiveBrush}"
                                         FailureBrush="{StaticResource DismissColor}" />
  </UserControl.Resources>
  <StackPanel Classes="settingsLayout">

    <DockPanel>
      <TextBlock Text="Network" />
      <ComboBox ItemsSource="{Binding Networks}"
                SelectedItem="{Binding Settings.Network}" />
    </DockPanel>

    <DockPanel
      ToolTip.Tip="The RPC interface of your own full node. The wallet gets blocks, unconfirmed transactions and fee rates from it and broadcasts its transactions through it. Nobody else is asked.">
      <TextBlock Text="Bitcoin RPC Endpoint" />
        <TextBox Text="{Binding BitcoinRpcUri}">
          <Interaction.Behaviors>
            <TextBoxAutoSelectTextBehavior />
            <WhitespacePasteRemovalBehavior />
            <WhitespaceInputRemovalBehavior />
          </Interaction.Behaviors>
        </TextBox>
    </DockPanel>
    <DockPanel>
      <TextBlock Text="Bitcoin RPC Credential String" />
      <TextBox Text="{Binding BitcoinRpcCredentialString}"
               Watermark="(rpcuser:rpcpassword or cookiefile=path)"/>
    </DockPanel>

    <DockPanel>
      <TextBlock Text="{Binding ConnectionStatusMessage}"
                 IsVisible="{Binding ConnectionStatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                 Foreground="{Binding ConnectionStatusIsSuccess, Converter={StaticResource BoolToConnectionStatusBrush}}"
                 VerticalAlignment="Center"
                 Margin="0,0,10,0" />
      <Button Content="Verify connection"
              Command="{Binding VerifyConnectionCommand}"
              HorizontalAlignment="Right" />
    </DockPanel>

    <DockPanel>
      <TextBlock Text="Tor" />
      <ComboBox ItemsSource="{Binding TorModes}" SelectedItem="{Binding Settings.UseTor}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="basemodels:TorMode">
            <TextBlock Text="{Binding Converter={x:Static conv:EnumConverters.ToFriendlyName}}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
        <ComboBox.Styles>
          <Style Selector="ComboBox /template/ Border#Background">
            <Setter Property="CornerRadius" Value="30" />
          </Style>
          <Style Selector="ComboBox /template/ Border#HighlightBackground">
            <Setter Property="CornerRadius" Value="30" />
          </Style>
        </ComboBox.Styles>
      </ComboBox>
    </DockPanel>

    <DockPanel IsVisible="{Binding Settings.UseTor, ConverterParameter={x:Static basemodels:TorMode.Enabled}, Converter={x:Static conv:EnumToBoolConverter.Instance}}">
      <TextBlock Text="Terminate Tor when Black Hole shuts down" />
      <ToggleSwitch IsChecked="{Binding Settings.TerminateTorOnExit}" />
    </DockPanel>
  </StackPanel>
</UserControl>
