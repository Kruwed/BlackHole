<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WalletWasabi.Fluent.ViewModels.Settings"
             mc:Ignorable="d" d:DesignWidth="428" d:DesignHeight="371"
             x:DataType="vm:ConfigureWalletViewModel"
             x:CompileBindings="True"
             x:Class="WalletWasabi.Fluent.Views.Settings.ConfigureWalletView">
  <ContentArea Title="{Binding Title}"
               Caption="What is done with the wallet as a whole."
               EnableCancel="{Binding EnableCancel}"
               EnableBack="{Binding EnableBack}"
               EnableNext="False"
               IsBusy="{Binding IsBusy}">
    <StackPanel Classes="settingsLayout" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
      <DockPanel ToolTip.Tip="{Binding ResyncWalletToolTip}">
        <TextBlock Text="Resync Wallet" />
        <Button Theme="{StaticResource FunctionButton}" Command="{Binding ResyncWalletCommand}" Content="Open" DockPanel.Dock="Right" />
      </DockPanel>
      <DockPanel ToolTip.Tip="{Binding WalletKeysToolTip}">
        <TextBlock Text="Wallet Keys" />
        <Button Theme="{StaticResource FunctionButton}" Command="{Binding WalletKeysCommand}" Content="Open" DockPanel.Dock="Right" />
      </DockPanel>
    </StackPanel>
  </ContentArea>
</UserControl>
