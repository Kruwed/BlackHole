<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:v="using:WalletWasabi.Fluent.Views.Settings"
             xmlns:vm="using:WalletWasabi.Fluent.ViewModels.Settings"
             mc:Ignorable="d" d:DesignWidth="428" d:DesignHeight="371"
             x:DataType="vm:ConnectToNodeViewModel"
             x:CompileBindings="True"
             x:Class="WalletWasabi.Fluent.Views.Settings.ConnectToNodeView">
  <UserControl.Styles>
    <Style Selector="TextBox /template/ DataValidationErrors">
      <Setter Property="MinHeight" Value="25" />
    </Style>
    <!-- The button that only asks stands next to the one that connects. -->
    <Style Selector="ContentArea /template/ ContentPresenter#PART_BottomContentPresenter">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0 0 12 0" />
    </Style>
  </UserControl.Styles>
  <ContentArea Title="{Binding Title}"
               Caption="Tell where the RPC interface of your Bitcoin node is."
               EnableCancel="{Binding EnableCancel}"
               EnableBack="{Binding EnableBack}"
               EnableNext="True" NextContent="{Binding NextLabel}"
               IsBusy="{Binding IsBusy}">
    <ContentArea.BottomContent>
      <Button Content="Verify Connection" Command="{Binding VerifyCommand}" />
    </ContentArea.BottomContent>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Width="520">
      <!-- Every name has what it names to its right, in one column. What explains a row is below the row, as wide as the page. -->
      <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,10,Auto,10,Auto,20,Auto,10,Auto">
        <Label Grid.Row="0" Grid.Column="0" Classes="besideBox" Content="RPC endpoint:" Target="TbRpcUri"
               ToolTip.Tip="The RPC interface of your own full node. The wallet gets blocks, unconfirmed transactions and fee rates from it and broadcasts its transactions through it. Nobody else is asked." />
        <TextBox Grid.Row="0" Grid.Column="2" Name="TbRpcUri"
                 Text="{Binding BitcoinRpcUri}"
                 Watermark="{Binding DefaultRpcUri}"
                 IsReadOnly="{Binding IsAsking}"
                 IsEnabled="{Binding !IsReadOnly}">
          <Interaction.Behaviors>
            <FocusOnAttachedBehavior />
            <WhitespacePasteRemovalBehavior />
            <WhitespaceInputRemovalBehavior />
          </Interaction.Behaviors>
        </TextBox>

        <Label Grid.Row="2" Grid.Column="0" Classes="besideBox" Content="RPC credentials:" Target="TbRpcCredentials" />
        <TextBox Grid.Row="2" Grid.Column="2" Name="TbRpcCredentials"
                 Text="{Binding BitcoinRpcCredentialString}"
                 Watermark="rpcuser:rpcpassword or cookiefile=path"
                 IsReadOnly="{Binding IsAsking}"
                 IsEnabled="{Binding !IsReadOnly}" />
        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="Leave the credentials empty to use the cookie file of a Bitcoin Core that runs on this computer."
                   TextWrapping="Wrap"
                   Opacity="0.6" />

        <!-- The network. It is applied when the application starts, and the node is asked on the network that the application runs on. -->
        <Label Grid.Row="6" Grid.Column="0" Classes="beside" Content="Network:" Target="CbNetwork" />
        <ComboBox Grid.Row="6" Grid.Column="2" Name="CbNetwork"
                  ItemsSource="{Binding Networks}"
                  SelectedItem="{Binding Settings.Network}"
                  IsEnabled="{Binding !AreSettingsReadOnly}"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" />
        <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="A change of the network takes a restart. Until then the node is asked on the network that Black Hole runs on."
                   TextWrapping="Wrap"
                   Opacity="0.6" />
      </Grid>

      <!-- What the node answered the last time. The room for it is always there, so that nothing moves when it appears. -->
      <v:ConnectionStatus MinHeight="40" Margin="0 10 0 0" />

      <InfoMessage Foreground="{StaticResource WarningMessageForeground}"
                   IsVisible="{Binding IsReadOnly}">
        <TextBlock Text="The node was given on the command line or in the environment when Black Hole was started, so it cannot be changed here."
                   TextWrapping="Wrap" />
      </InfoMessage>

      <v:RestartNotice />
    </StackPanel>
  </ContentArea>
</UserControl>
