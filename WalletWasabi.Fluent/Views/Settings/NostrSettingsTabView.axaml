<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="using:WalletWasabi.Fluent.ViewModels.Settings"
             mc:Ignorable="d" d:DesignWidth="650"
             x:Class="WalletWasabi.Fluent.Views.Settings.NostrSettingsTabView"
             x:CompileBindings="True"
             x:DataType="settings:NostrSettingsTabViewModel">
  <StackPanel Classes="settingsLayout">

    <!-- The relays, one on a line. The box is wider than the other boxes of the settings: an address is long. -->
    <DockPanel>
      <TextBlock Text="Nostr Relays" />
      <TextBox Text="{Binding Relays}"
               Width="360" Height="140"
               AcceptsReturn="True" TextWrapping="NoWrap"
               Classes="monoSpaced"
               Watermark="wss://relay.example"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </DockPanel>

    <TextBlock TextWrapping="Wrap" Opacity="0.6"
               Text="The Nostr relays that Black Hole connects to, one address on a line. Your offer as a market maker is posted to them, through Tor unless Tor is turned off. Nothing is sent to a relay before you post an offer, and with no relay in the list no offer can be posted. A new installation starts with wss://relay.primal.net, wss://relay.damus.io and wss://nos.lol." />
  </StackPanel>
</UserControl>
