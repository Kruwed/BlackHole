<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:v="using:WalletWasabi.Fluent.Views.Settings"
             xmlns:vm="using:WalletWasabi.Fluent.ViewModels.Settings"
             mc:Ignorable="d" d:DesignWidth="428" d:DesignHeight="371"
             x:DataType="vm:ConnectToNostrViewModel"
             x:CompileBindings="True"
             x:Class="WalletWasabi.Fluent.Views.Settings.ConnectToNostrView">
  <UserControl.Styles>
    <Style Selector="TextBox /template/ DataValidationErrors">
      <Setter Property="MinHeight" Value="25" />
    </Style>
    <!-- The button that only asks stands next to the one that connects. -->
    <Style Selector="ContentArea /template/ ContentPresenter#PART_BottomContentPresenter">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0 0 12 0" />
    </Style>
  </UserControl.Styles>
  <ContentArea Title="{Binding Title}"
               Caption="Name the Nostr relays that Black Hole connects to."
               EnableCancel="{Binding EnableCancel}"
               EnableBack="{Binding EnableBack}"
               EnableNext="True" NextContent="{Binding NextLabel}"
               IsBusy="{Binding IsBusy}">
    <ContentArea.BottomContent>
      <Button Content="Verify Connection" Command="{Binding VerifyCommand}" />
    </ContentArea.BottomContent>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Width="420">
      <Label Content="Nostr relays, one address on a line:" Target="TbRelays" />
      <!-- Enter starts a new line here, so the relays are connected to with the button. -->
      <TextBox Name="TbRelays"
               Text="{Binding Relays}"
               Height="100"
               AcceptsReturn="True" TextWrapping="NoWrap"
               Classes="monoSpaced"
               Watermark="wss://relay.example"
               IsReadOnly="{Binding IsAsking}"
               IsEnabled="{Binding !IsReadOnly}"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
        <Interaction.Behaviors>
          <FocusOnAttachedBehavior />
        </Interaction.Behaviors>
      </TextBox>

      <!-- What the relays answered the last time. The room for it is always there, so that nothing moves when it appears. -->
      <v:ConnectionStatus MinHeight="60" Margin="0 10 0 0" />

      <InfoMessage Foreground="{StaticResource WarningMessageForeground}"
                   IsVisible="{Binding IsReadOnly}">
        <TextBlock Text="The relays were given on the command line or in the environment when Black Hole was started, so they cannot be changed here."
                   TextWrapping="Wrap" />
      </InfoMessage>

      <v:RestartNotice />
    </StackPanel>
  </ContentArea>
</UserControl>
