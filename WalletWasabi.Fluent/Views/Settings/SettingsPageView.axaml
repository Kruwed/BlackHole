<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:v="using:WalletWasabi.Fluent.Views.Settings"
             xmlns:settings="using:WalletWasabi.Fluent.ViewModels.Settings"
             xmlns:conv="using:WalletWasabi.Fluent.Converters"
             mc:Ignorable="d" d:DesignWidth="428" d:DesignHeight="371"
             x:DataType="settings:SettingsPageViewModel"
             x:CompileBindings="True"
             x:Class="WalletWasabi.Fluent.Views.Settings.SettingsPageView">

  <ContentArea Title="{Binding Title}"
                 Caption="Manage connection and coordinator settings"
                 EnableNext="True"
                 NextContent="Done"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
    <DockPanel LastChildFill="True">

      <InfoMessage Foreground="{DynamicResource WarningMessageForeground}"
                     Margin="0,16,0,0"
                     HorizontalAlignment="Center"
                     Opacity="{Binding IsModified, Converter={x:Static conv:BoolOpacityConverters.BoolToOpacity}}"
                     DockPanel.Dock="Bottom">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Changes will be applied after restarting the application." />
          <Button Content="Restart Black Hole" Classes="activeHyperLink plain" Margin="5 0 0 0" Command="{Binding RestartCommand}" />
        </StackPanel>
      </InfoMessage>
      <InfoMessage Foreground="{StaticResource WarningMessageForeground}"
                     Margin="0,16,0,0"
                     HorizontalAlignment="Center"
                     IsVisible="{Binding IsReadOnly}"
                     DockPanel.Dock="Bottom">
        <TextBlock Text="Modifying settings is not possible, as certain parameters have been overridden during startup." />
      </InfoMessage>

      <TabControl SelectedIndex="{Binding SelectedTab, Mode=TwoWay}"
                  Classes="Settings">
        <TabItem Header="Connections">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="15">
              <v:ConnectionsSettingsTabView DataContext="{Binding ConnectionsSettingsTab}" IsEnabled="{Binding !IsReadOnly}" />

              <!-- The wallet reads the blocks of the node again. That is not a setting: it works while the settings are read-only too. -->
              <StackPanel Classes="settingsLayout" IsVisible="{Binding HasWallet}">
                <DockPanel ToolTip.Tip="{Binding ResyncWalletToolTip}">
                  <TextBlock Text="Resync Wallet" />
                  <Button Theme="{StaticResource FunctionButton}" Command="{Binding ResyncWalletCommand}" Content="Open" DockPanel.Dock="Right" />
                </DockPanel>
                <DockPanel ToolTip.Tip="{Binding WalletKeysToolTip}">
                  <TextBlock Text="Wallet Keys" />
                  <Button Theme="{StaticResource FunctionButton}" Command="{Binding WalletKeysCommand}" Content="Open" DockPanel.Dock="Right" />
                </DockPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Coordinator">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <v:CoordinatorTabSettingsView DataContext="{Binding CoordinatorTabSettings}" />
          </ScrollViewer>
        </TabItem>

      </TabControl>
    </DockPanel>
  </ContentArea>
</UserControl>
