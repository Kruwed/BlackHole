<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:WalletWasabi.Fluent.ViewModels.Wallets.Settings"
             x:DataType="vm:WalletCoinJoinSettingsViewModel"
             x:Class="WalletWasabi.Fluent.Views.Wallets.Settings.WalletCoinJoinSettingsView"
             x:CompileBindings="True">
  <ContentArea Title="{Binding Title}"
               EnableNext="True" NextContent="Done"
               EnableCancel="{Binding EnableCancel}"
               EnableBack="{Binding EnableBack}">
    <StackPanel Classes="settingsLayout">
      <StackPanel Margin="0 0 0 20"
              Opacity="0.85"
              Spacing="40"
              HorizontalAlignment="Center"
              Orientation="Horizontal"
              Classes="settingsLayout">
        <Button Theme="{StaticResource FunctionButton}"
                Height="37"
                Command="{Binding SelectMaximizePrivacySettings}"
                Classes.selected="{Binding MaximizePrivacyProfileSelected}"
                ToolTip.Tip="Repeats coinjoins to increase privacy, but costs additional fees.">
          <StackPanel Spacing="10" Orientation="Horizontal">
            <PathIcon Opacity="0.9" Foreground="{DynamicResource FunctionButtonForegroundColor}" Data="{StaticResource double_shield_regular}" />
            <TextBlock Margin="0 2 0 0" Text="Enhance Privacy" />
          </StackPanel>
        </Button>
        <Button Theme="{StaticResource FunctionButton}"
                Height="37"
                Command="{Binding SelectDefaultSettings}"
                Classes.selected="{Binding DefaultProfileSelected}"
                ToolTip.Tip="Balances privacy and cost.">
          <StackPanel Spacing="10" Orientation="Horizontal">
            <PathIcon Opacity="0.9" Foreground="{DynamicResource FunctionButtonForegroundColor}" Data="{StaticResource shield_regular}" />
            <TextBlock Margin="0 2 0 0" Text="Default Strategy" />
          </StackPanel>
        </Button>
        <Button Theme="{StaticResource FunctionButton}"
                Height="37"
                Command="{Binding SelectEconomicalSettings}"
                Classes.selected="{Binding EconomicalProfileSelected}"
                ToolTip.Tip="Minimizes transaction fees and allows non-private coin consolidation.">
          <StackPanel Spacing="10" Orientation="Horizontal">
            <PathIcon Opacity="0.9" Foreground="{DynamicResource FunctionButtonForegroundColor}" Data="{StaticResource coinjoin_cost}" />
            <TextBlock Margin="0 2 0 0" Text="Reduce Costs" />
          </StackPanel>
        </Button>
      </StackPanel>

      <DockPanel ToolTip.Tip="Each round can register at most one non-private coin.">
        <TextBlock Text="Non-private coin isolation" />
        <ToggleSwitch IsChecked="{Binding NonPrivateCoinIsolation}" Command="{Binding SetNonPrivateCoinIsolationCommand}" />
      </DockPanel>

      <DockPanel ToolTip.Tip="When enabled, payments in coinjoin are only funded with coins that reached the anonymity score target, so a payment waits until the wallet is private. When disabled, any coin can fund them.">
        <TextBlock Text="Only use private funds for coinjoin payments" />
        <ToggleSwitch IsChecked="{Binding OnlyUsePrivateFundsForPayments}" Command="{Binding SetOnlyUsePrivateFundsForPaymentsCommand}" />
      </DockPanel>

      <DockPanel>
        <TextBlock Text="Anonymity score target" ToolTip.Tip="Minimum anonymity score to consider a coin private." />
        <TextBox Classes="standalone" Name="AnonScoreTargetTextBox" Text="{Binding AnonScoreTarget}" DockPanel.Dock="Right" Width="56" HorizontalContentAlignment="Center" MaxLength="3" />
        <Slider Name="AnonScoreTargetSlider" Value="{Binding AnonScoreTargetSliderPosition}"
                Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                Margin="0 -6 20 0" VerticalAlignment="Top"
                ToolTip.Tip="Minimum anonymity score to consider a coin private." />
      </DockPanel>

      <Separator />

      <DockPanel>
        <TextBlock Text="Automatically start coinjoin" />
        <ToggleSwitch IsChecked="{Binding AutoCoinJoin}" Command="{Binding SetAutoCoinJoin}" />
      </DockPanel>

      <DockPanel ToolTip.Tip="Coinjoin will automatically stop if the confirmed wallet balance is below this.">
        <TextBlock Text="Stop coinjoin threshold" />
        <CurrencyEntryBox Classes="standalone" Text="{Binding PlebStopThreshold}" CurrencyCode="BTC" />
      </DockPanel>

      <DockPanel ToolTip.Tip="A coinjoin splits your coins into standard amounts. What is left and is too small for an output of its own goes to the miners. If more than this limit would be left, it is added to one of your outputs instead: you keep it, but that output has a non-standard amount and gains less privacy. The limit is 0.0001 BTC at most.">
        <TextBlock Text="Dust forfeit limit" />
        <CurrencyEntryBox Classes="standalone" Text="{Binding MaxCoinjoinLeftover}" CurrencyCode="BTC" />
      </DockPanel>
    </StackPanel>
  </ContentArea>
</UserControl>
