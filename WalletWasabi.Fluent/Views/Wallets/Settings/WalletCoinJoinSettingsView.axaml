<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:WalletWasabi.Fluent.ViewModels.Wallets.Settings"
             x:DataType="vm:WalletCoinJoinSettingsViewModel"
             x:Class="WalletWasabi.Fluent.Views.Wallets.Settings.WalletCoinJoinSettingsView"
             x:CompileBindings="True">
  <ContentArea Title="{Binding Title}"
               EnableNext="True" NextContent="Done"
               EnableCancel="{Binding EnableCancel}"
               EnableBack="{Binding EnableBack}">
    <StackPanel Classes="settingsLayout">
      <DockPanel ToolTip.Tip="Each round can register at most one coin that has an anonymity score of 1.">
        <TextBlock Text="Non-private coin isolation" />
        <ToggleSwitch IsChecked="{Binding NonPrivateCoinIsolation}" Command="{Binding SetNonPrivateCoinIsolationCommand}" />
      </DockPanel>

      <DockPanel ToolTip.Tip="A coinjoin splits your coins into standard amounts. What is left and is too small for an output of its own goes to the miners. If more than this limit would be left, it is added to one of your outputs instead: you keep it, but that output has a non-standard amount and gains less privacy. The limit is 0.0001 BTC at most.">
        <TextBlock Text="Dust forfeit limit" />
        <CurrencyEntryBox Classes="standalone" Text="{Binding MaxCoinjoinLeftover}" CurrencyCode="BTC" />
      </DockPanel>
    </StackPanel>
  </ContentArea>
</UserControl>
