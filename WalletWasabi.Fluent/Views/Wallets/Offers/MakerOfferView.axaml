<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WalletWasabi.Fluent.ViewModels.Wallets.Offers"
             x:DataType="vm:MakerOfferViewModel"
             x:CompileBindings="True"
             x:Class="WalletWasabi.Fluent.Views.Wallets.Offers.MakerOfferView">

  <UserControl.Styles>
    <!-- A field has room for a message of one line below its box, so that a message that comes or goes does not move what is below.
         The box is as wide as the field, and so is the message: the unit is in the label. -->
    <Style Selector="StackPanel.field">
      <Setter Property="MinHeight" Value="108" />
      <Setter Property="Spacing" Value="4" />
    </Style>
    <Style Selector="TextBlock.complaint">
      <Setter Property="Foreground" Value="{DynamicResource SystemErrorTextColor}" />
    </Style>
  </UserControl.Styles>

  <!-- The main screen of the Maker tab of the Coinjoin dialog: the terms of the offer and what an offer means. The
       dialog has its buttons, Bond among them. -->
  <StackPanel>

    <!-- The terms of the offer. -->
    <Grid ColumnDefinitions="*,16,*,16,*">
      <StackPanel Grid.Column="0" Classes="field"
                  ToolTip.Tip="The lowest mining fee rate of a coinjoin that your coins go into.">
        <Label Content="Minimum _fee rate (sat/vB)" Target="FeeRateBox" />
        <TextBox Name="FeeRateBox" Text="{Binding MinFeeRateText}" MaxLength="12">
          <Interaction.Behaviors>
            <FocusOnAttachedBehavior />
          </Interaction.Behaviors>
        </TextBox>
      </StackPanel>

      <StackPanel Grid.Column="2" Classes="field"
                  ToolTip.Tip="What you pay the taker for every anonymity point that your coins gain in the coinjoin.">
        <Label Content="_Bid (sats per point)" Target="BidBox" />
        <TextBox Name="BidBox" Text="{Binding BidText}" MaxLength="20" />
      </StackPanel>

      <StackPanel Grid.Column="4" Classes="field"
                  ToolTip.Tip="What the taker pays you for every anonymity point that your coins lose in the coinjoin.">
        <Label Content="_Ask (sats per point)" Target="AskBox" />
        <TextBox Name="AskBox" Text="{Binding AskText}" MaxLength="20" />
      </StackPanel>
    </Grid>

    <!-- The coins of the offer: which ones they are, or what is to be done first. -->
    <TextBlock TextWrapping="Wrap" Text="{Binding CoinsText}" Classes.complaint="{Binding HasNoCoinsToOffer}" />

    <!-- What an offer means, and where it goes. -->
    <StackPanel Spacing="6" Margin="0 16 0 0">
      <TextBlock TextWrapping="Wrap" Classes="complaint"
                 Text="{Binding ErrorMessage}"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock TextWrapping="Wrap" Opacity="0.6"
                 Text="A coinjoin destroys the anonymity points of the coins that go into it, and the coins that you get out of it have the points of the new transaction. If you have more points afterwards, you pay the taker the bid for each of them. If you have fewer, the taker pays you the ask for each." />
      <TextBlock TextWrapping="Wrap" Opacity="0.6" Text="{Binding PostingText}" />
    </StackPanel>
  </StackPanel>
</UserControl>
