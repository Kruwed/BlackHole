<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tabs="clr-namespace:WalletWasabi.Fluent.ViewModels.Wallets.Tabs"
             xmlns:history="using:WalletWasabi.Fluent.Views.Wallets.Home.History"
             x:DataType="tabs:HistoryTabViewModel"
             x:CompileBindings="True"
             ClipToBounds="False"
             x:Class="WalletWasabi.Fluent.Views.Wallets.Tabs.HistoryTabView">
  <history:HistoryTable DataContext="{Binding History}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
</UserControl>
