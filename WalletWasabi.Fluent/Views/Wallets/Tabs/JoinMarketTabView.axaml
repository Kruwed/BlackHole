<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tabs="clr-namespace:WalletWasabi.Fluent.ViewModels.Wallets.Tabs"
             x:DataType="tabs:JoinMarketTabViewModel"
             x:CompileBindings="True"
             ClipToBounds="False"
             x:Class="WalletWasabi.Fluent.Views.Wallets.Tabs.JoinMarketTabView">
  <DockPanel>

    <!-- What makes this wallet a market maker is at the right end: its fidelity bonds and its offer. The buttons wait for the wallet to know its transactions. -->
    <DockPanel DockPanel.Dock="Top" Margin="0 10 0 20">
      <Button DockPanel.Dock="Right" Classes="function" Command="{Binding BondCommand}" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <PathIcon Data="{StaticResource wallet_action_bond}" />
          <TextBlock Text="Bond" />
        </StackPanel>
      </Button>
      <Button DockPanel.Dock="Right" Classes="function" Command="{Binding OfferCommand}" VerticalAlignment="Center" Margin="0 0 8 0">
        <StackPanel Orientation="Horizontal">
          <PathIcon Data="{StaticResource wallet_action_offer}" />
          <TextBlock Text="Offer" />
        </StackPanel>
      </Button>
      <TextBlock VerticalAlignment="Center" Text="Market Makers" FontSize="{StaticResource FontSizeH5}" />
    </DockPanel>

    <!-- The list of the market makers: its columns, the offer of this wallet if it has one, and rows that are empty until the wallet finds makers. -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="2*,*,*,*,*,*,*" Margin="14 0 14 8">
      <Grid.Styles>
        <Style Selector="TextBlock">
          <Setter Property="Opacity" Value="0.6" />
          <Setter Property="FontSize" Value="13" />
        </Style>
      </Grid.Styles>
      <!-- The maker has the widest column: it is the one with a name in it. -->
      <TextBlock Grid.Column="0" Text="{Binding MarketMakerColumns[0]}" />
      <TextBlock Grid.Column="1" Text="{Binding MarketMakerColumns[1]}" />
      <TextBlock Grid.Column="2" Text="{Binding MarketMakerColumns[2]}" />
      <TextBlock Grid.Column="3" Text="{Binding MarketMakerColumns[3]}" />
      <TextBlock Grid.Column="4" Text="{Binding MarketMakerColumns[4]}" />
      <TextBlock Grid.Column="5" Text="{Binding MarketMakerColumns[5]}" />
      <TextBlock Grid.Column="6" Text="{Binding MarketMakerColumns[6]}" />
    </Grid>

    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding MarketMakers}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="tabs:MarketMakerRow">
          <Border CornerRadius="15" Background="{DynamicResource Layer1BackgroundBrush}" Margin="2"
                  Height="{StaticResource TreeDataGridRowHeight}">
            <Grid ColumnDefinitions="2*,*,*,*,*,*,*" Margin="12 0" VerticalAlignment="Center">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Maker}" VerticalAlignment="Center" />
                <!-- The relays could not be told the last time. -->
                <PathIcon Data="{StaticResource warning_regular}" Height="14" Width="14" VerticalAlignment="Center"
                          Foreground="{DynamicResource SystemErrorTextColor}"
                          IsVisible="{Binding HasProblem}"
                          ToolTip.Tip="{Binding Problem}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding FeeRate}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding Spread}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Text="{Binding Bid}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="4" Text="{Binding Ask}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="5" Text="{Binding Liquidity}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="6" Text="{Binding Bond}" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <DummyRowsControl Margin="{StaticResource HistoryTablePlaceholderPanelMargin}"
                      RowHeight="{StaticResource TreeDataGridRowHeight}">
      <DummyRowsControl.RowTemplate>
        <ControlTemplate>
          <Border CornerRadius="15" Background="{DynamicResource Layer1BackgroundBrush}" Margin="2" />
        </ControlTemplate>
      </DummyRowsControl.RowTemplate>
    </DummyRowsControl>
  </DockPanel>
</UserControl>
