<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tabs="clr-namespace:WalletWasabi.Fluent.ViewModels.Wallets.Tabs"
             xmlns:market="clr-namespace:WalletWasabi.Fluent.ViewModels.Wallets.Market"
             x:DataType="tabs:OrderBookTabViewModel"
             x:CompileBindings="True"
             ClipToBounds="False"
             x:Class="WalletWasabi.Fluent.Views.Wallets.Tabs.OrderBookTabView">

  <UserControl.Resources>
    <SolidColorBrush x:Key="MarketAccentBrush" Color="#f2a325" />
    <SolidColorBrush x:Key="MarketAccentFillBrush" Color="#4d3008" />
    <SolidColorBrush x:Key="MarketDividerBrush" Color="#52f2a325" />
  </UserControl.Resources>

  <UserControl.Styles>
    <StyleInclude Source="avares://WalletWasabi.Fluent/Views/Wallets/Market/MarketStyles.axaml" />
    <Style Selector="ListBox.marketList ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="ListBox.marketList ListBoxItem /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <!-- The order book as the relays tell it: the makers with a bond first, then the others. Makers are picked on the
       Taker tab of the Coinjoin dialog, which has this book with its filters. -->
  <DockPanel>

    <TextBlock DockPanel.Dock="Top" Margin="0 10 0 20" Text="Makers" FontSize="{StaticResource FontSizeH5}" />

    <Grid DockPanel.Dock="Top" ColumnDefinitions="1.7*,*,*,*,*,1.5*,1.5*" Margin="14 0 14 8">
      <Grid.Styles>
        <Style Selector="TextBlock">
          <Setter Property="Opacity" Value="0.6" />
          <Setter Property="FontSize" Value="13" />
          <Setter Property="TextAlignment" Value="Right" />
        </Style>
      </Grid.Styles>
      <TextBlock Grid.Column="0" Text="{Binding MarketMakerColumns[0]}" TextAlignment="Left" />
      <TextBlock Grid.Column="1" Text="{Binding MarketMakerColumns[1]}" />
      <TextBlock Grid.Column="2" Text="{Binding MarketMakerColumns[2]}" />
      <TextBlock Grid.Column="3" Text="{Binding MarketMakerColumns[3]}" />
      <TextBlock Grid.Column="4" Text="{Binding MarketMakerColumns[4]}" />
      <TextBlock Grid.Column="5" Text="{Binding MarketMakerColumns[5]}" />
      <TextBlock Grid.Column="6" Text="{Binding MarketMakerColumns[6]}" />
    </Grid>

    <!-- What there is to say about the book besides its rows: that the relays did not answer, for instance. -->
    <TextBlock DockPanel.Dock="Top" Margin="14 4 14 8" Opacity="0.6" TextWrapping="Wrap"
               Text="{Binding Notice}"
               IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <ListBox Classes="marketList" ItemsSource="{Binding Rows}" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.DataTemplates>
        <DataTemplate x:DataType="market:BookRowViewModel">
          <Border CornerRadius="15" Background="{DynamicResource Layer1BackgroundBrush}" Margin="2" Height="{StaticResource TreeDataGridRowHeight}">
            <Grid ColumnDefinitions="1.7*,*,*,*,*,1.5*,1.5*" Margin="12 0" VerticalAlignment="Center">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding Alias}" VerticalAlignment="Center" />
                <Border Classes="marketTag" IsVisible="{Binding IsOwn}">
                  <TextBlock Text="you" />
                </Border>
              </StackPanel>
              <TextBlock Grid.Column="1" Classes="marketCell" FontSize="13" Text="{Binding FeeRate}" />
              <TextBlock Grid.Column="2" Classes="marketCell" FontSize="13" Text="{Binding Spread}" />
              <TextBlock Grid.Column="3" Classes="marketCell" FontSize="13" Text="{Binding SellRate}" Foreground="{StaticResource MarketSellBrush}" />
              <TextBlock Grid.Column="4" Classes="marketCell" FontSize="13" Text="{Binding BuyRate}" Foreground="{StaticResource MarketBuyBrush}" />
              <TextBlock Grid.Column="5" Classes="marketCell" FontSize="13" Text="{Binding Liquidity}" />
              <TextBlock Grid.Column="6" Classes="marketCell" FontSize="13" Text="{Binding Bond}" />
            </Grid>
          </Border>
        </DataTemplate>
        <DataTemplate x:DataType="market:BookCaptionViewModel">
          <TextBlock Classes="marketLabel" Text="{Binding Text}" Margin="14 18 14 8" />
        </DataTemplate>
      </ListBox.DataTemplates>
    </ListBox>
  </DockPanel>
</UserControl>
