<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tabs="clr-namespace:WalletWasabi.Fluent.ViewModels.Wallets.Tabs"
             xmlns:coins="clr-namespace:WalletWasabi.Fluent.Views.Wallets.Coins"
             xmlns:sorting="clr-namespace:WalletWasabi.Fluent.Controls.Sorting"
             x:DataType="tabs:WabiSabiTabViewModel"
             x:CompileBindings="True"
             ClipToBounds="False"
             x:Class="WalletWasabi.Fluent.Views.Wallets.Tabs.WabiSabiTabView">
  <UserControl.Styles>
    <Style Selector="Border#CoinjoinBox :is(TextBlock)">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border#CoinjoinBox Button:disabled PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource TextControlForegroundDisabled}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <!-- The coinjoin: what it is doing, and its controls -->
    <Border Name="CoinjoinBox" DockPanel.Dock="Top" HorizontalAlignment="Left" ClipToBounds="True" Margin="0 4 0 4"
            TextElement.FontFamily="{StaticResource MonospacedFont}"
            CornerRadius="4"
            BorderBrush="{DynamicResource GlassEdgeColor}"
            BorderThickness="1">
      <Panel>
        <Panel Background="{DynamicResource TileRegionColor}" Opacity="0.35" />
        <StackPanel Margin="10 8" Orientation="Horizontal" Spacing="20">
          <Image Height="35" Width="35" VerticalAlignment="Center" HorizontalAlignment="Center"
                 Source="{DynamicResource app_logo_dynamic}" />

          <!-- With a coordinator -->
          <StackPanel Orientation="Horizontal" Spacing="20" IsVisible="{Binding IsCoinJoinEnabled}">

            <!-- The wallet is loaded: what the coinjoin is doing -->
            <StackPanel Spacing="5" Width="350" VerticalAlignment="Center"
                        IsVisible="{Binding CoinJoinState, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TransitioningContentControl MinHeight="18" Content="{Binding CoinJoinState.CurrentStatus}">
                <TransitioningContentControl.PageTransition>
                  <PageSlide Duration="0:0:0.125" Orientation="Vertical" SlideInEasing="0.4,0,0.6,1" SlideOutEasing="0.4,0,0.6,1" />
                </TransitioningContentControl.PageTransition>
                <TransitioningContentControl.DataTemplates>
                  <DataTemplate DataType="x:String">
                    <TextBlock Text="{Binding .}" />
                  </DataTemplate>
                </TransitioningContentControl.DataTemplates>
              </TransitioningContentControl>

              <ProgressBar Minimum="0" Maximum="100" IsIndeterminate="{Binding CoinJoinState.IsCountDownDelayHappening, FallbackValue=False}" Value="{Binding CoinJoinState.ProgressValue, FallbackValue=0}">
                <ProgressBar.Foreground>
                  <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.4" />
                </ProgressBar.Foreground>
                <ProgressBar.Background>
                  <SolidColorBrush Color="{DynamicResource SystemBaseMediumColor}" Opacity="0.5" />
                </ProgressBar.Background>
              </ProgressBar>

              <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding CoinJoinState.LeftText}" DockPanel.Dock="Left" />
                <TextBlock Text="{Binding CoinJoinState.RightText}" DockPanel.Dock="Right" />
              </DockPanel>
            </StackPanel>

            <!-- The wallet is not loaded yet: the controls come with it -->
            <StackPanel Spacing="4" Width="350" VerticalAlignment="Center"
                        IsVisible="{Binding CoinJoinState, Converter={x:Static ObjectConverters.IsNull}}">
              <TextBlock Text="Coinjoin waits for the wallet" />
              <TextBlock Text="It is processing the blocks" />
            </StackPanel>

            <Separator Classes="vertical" />

            <Button Classes="plain"
                    IsVisible="{Binding CoinJoinState.PlayVisible, FallbackValue=False}"
                    Command="{Binding CoinJoinState.PlayCommand}"
                    ToolTip.Tip="Start a coinjoin round">
              <PathIcon Data="{StaticResource play_regular}" />
            </Button>

            <Button Classes="plain"
                    IsVisible="{Binding CoinJoinState.StopVisible, FallbackValue=False}"
                    Command="{Binding CoinJoinState.StopCommand}"
                    ToolTip.Tip="Stop coinjoin">
              <PathIcon Data="{StaticResource stop_regular}" />
            </Button>

            <Button Classes="plain" ToolTip.Tip="Settings and more">
              <Button.Flyout>
                <MenuFlyout Placement="Bottom">
                  <MenuItem Header="Coordinator Settings" Command="{Binding CoordinatorSettingsCommand}">
                    <MenuItem.Icon>
                      <PathIcon Data="{StaticResource coordinator}" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Coinjoin Payments" Command="{Binding CoinJoinState.CoinJoinPaymentsCommand}"
                            IsVisible="{Binding CoinJoinState, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <MenuItem.Icon>
                      <PathIcon Data="{StaticResource embedded_payment}" />
                    </MenuItem.Icon>
                  </MenuItem>
                </MenuFlyout>
              </Button.Flyout>
              <PathIcon Data="{StaticResource more_regular}" Opacity="0.6" />
            </Button>
          </StackPanel>

          <!-- Without a coordinator there is no coinjoin -->
          <StackPanel Orientation="Horizontal" Spacing="20" IsVisible="{Binding !IsCoinJoinEnabled}">
            <StackPanel Spacing="4" Width="350" VerticalAlignment="Center">
              <TextBlock Text="Coordinator not configured" />
              <TextBlock Text="Coinjoin not available" />
            </StackPanel>

            <Separator Classes="vertical" />

            <Button Classes="plain" ToolTip.Tip="Settings">
              <Button.Flyout>
                <MenuFlyout Placement="Bottom">
                  <MenuItem Header="Coordinator Settings" Command="{Binding CoordinatorSettingsCommand}">
                    <MenuItem.Icon>
                      <PathIcon Data="{StaticResource coordinator}" />
                    </MenuItem.Icon>
                  </MenuItem>
                </MenuFlyout>
              </Button.Flyout>
              <PathIcon Data="{StaticResource more_regular}" Opacity="0.6" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Panel>
    </Border>

    <!-- The coins of the wallet. A round gets the ticked ones. -->
    <DockPanel DockPanel.Dock="Top" Margin="0 16 0 4">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="5">
        <Button Theme="{StaticResource DialogSortButton}" ToolTip.Tip="Sorting">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <sorting:SortControl Sortables="{Binding CoinList.Sortables}" />
            </Flyout>
          </Button.Flyout>
        </Button>
        <ToggleButton Theme="{StaticResource DialogSelectAllButton}"
                      Command="{Binding ToggleSelectionCommand}"
                      IsChecked="{Binding HasSelection}" />
      </StackPanel>
      <TextBlock VerticalAlignment="Center" Text="Coins" FontSize="{StaticResource FontSizeH5}" />
    </DockPanel>

    <Panel DockPanel.Dock="Top" Margin="0 0 0 10" Opacity="0.6">
      <TextBlock Text="A round gets the ticked coins that it accepts, 10 at most: the largest go first. Untick a coin to keep it out."
                 TextWrapping="Wrap" IsVisible="{Binding !IsCoinjoining}" />
      <TextBlock Text="A round is under way. The ticks can be changed once it is over or the coinjoin is stopped."
                 TextWrapping="Wrap" IsVisible="{Binding IsCoinjoining}" />
    </Panel>

    <Panel IsEnabled="{Binding !IsCoinjoining}">
      <coins:CoinListView DataContext="{Binding CoinList}" />
    </Panel>
  </DockPanel>
</UserControl>
