<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tabs="clr-namespace:WalletWasabi.Fluent.ViewModels.Wallets.Tabs"
             xmlns:sorting="clr-namespace:WalletWasabi.Fluent.Controls.Sorting"
             x:DataType="tabs:ReceiveTabViewModel"
             x:CompileBindings="True"
             ClipToBounds="False"
             x:Class="WalletWasabi.Fluent.Views.Wallets.Tabs.ReceiveTabView">
  <DockPanel>

    <!-- A new address -->
    <Button DockPanel.Dock="Top" Classes="function" Command="{Binding GenerateCommand}"
            HorizontalAlignment="Left" Margin="0 10 0 0"
            ToolTip.Tip="Generates an address that was not given out before and shows it.">
      <StackPanel Orientation="Horizontal">
        <PathIcon Data="{StaticResource wallet_action_receive}" />
        <TextBlock Text="New Address" />
      </StackPanel>
    </Button>

    <!-- The addresses that were generated and have not been paid to yet -->
    <StackPanel DockPanel.Dock="Top" Margin="0 20 0 20" HorizontalAlignment="Left" Orientation="Horizontal" Spacing="6">
      <TextBlock VerticalAlignment="Center" Text="Addresses Awaiting Payment" FontSize="{StaticResource FontSizeH5}" />
      <Button IsVisible="{Binding HasAddresses}" Theme="{StaticResource HistorySortButton}" ToolTip.Tip="Sorting">
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft">
            <sorting:SortControl Sortables="{Binding Sortables}" />
          </Flyout>
        </Button.Flyout>
      </Button>
    </StackPanel>

    <Panel>
      <TreeDataGrid Source="{Binding Source}" VerticalAlignment="Stretch" IsVisible="{Binding HasAddresses}">
        <Interaction.Behaviors>
          <TreeDataGridMissingCellsWorkaroundBehavior />
        </Interaction.Behaviors>
        <TreeDataGrid.Styles>
          <Style Selector="TreeDataGridRow">
            <Setter Property="Theme" Value="{StaticResource ReceiveAddressesViewTreeDataGridRow}" />
          </Style>
        </TreeDataGrid.Styles>
      </TreeDataGrid>
      <TextBlock Text="No address is awaiting a payment. Give each address to one payer only: payments to the same address are linked to each other."
                 IsVisible="{Binding !HasAddresses}" Opacity="0.6" TextWrapping="Wrap"
                 HorizontalAlignment="Left" VerticalAlignment="Top" />
    </Panel>
  </DockPanel>
</UserControl>
