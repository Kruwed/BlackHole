<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tabs="clr-namespace:WalletWasabi.Fluent.ViewModels.Wallets.Tabs"
             xmlns:receive="clr-namespace:WalletWasabi.Fluent.ViewModels.Wallets.Receive"
             x:DataType="tabs:ReceiveTabViewModel"
             x:CompileBindings="True"
             ClipToBounds="False"
             x:Class="WalletWasabi.Fluent.Views.Wallets.Tabs.ReceiveTabView">

  <UserControl.Resources>
    <!-- What a right click on an address of the list offers. -->
    <ContextMenu x:Key="AddressContextMenu" x:DataType="receive:AddressViewModel">
      <MenuItem Header="Copy Bitcoin Address" Command="{Binding CopyAddressCommand}">
        <MenuItem.Icon>
          <PathIcon Data="{StaticResource btc_logo}" />
        </MenuItem.Icon>
      </MenuItem>
    </ContextMenu>
  </UserControl.Resources>

  <DockPanel>

    <!-- The addresses that were generated and have not been paid to yet, and at the right end the button for a new one -->
    <DockPanel DockPanel.Dock="Top" Margin="0 10 0 20">
      <Button DockPanel.Dock="Right" Classes="function" Command="{Binding GenerateCommand}"
              VerticalAlignment="Center"
              ToolTip.Tip="Generates an address that was not given out before and shows it.">
        <StackPanel Orientation="Horizontal">
          <PathIcon Data="{StaticResource wallet_action_receive}" />
          <TextBlock Text="New Address" />
        </StackPanel>
      </Button>
      <TextBlock VerticalAlignment="Center" Text="Addresses Awaiting Payment" FontSize="{StaticResource FontSizeH5}" />
    </DockPanel>

    <Panel>
      <TreeDataGrid Source="{Binding Source}" VerticalAlignment="Stretch" IsVisible="{Binding HasAddresses}">
        <Interaction.Behaviors>
          <TreeDataGridMissingCellsWorkaroundBehavior />
        </Interaction.Behaviors>
        <TreeDataGrid.Styles>
          <Style Selector="TreeDataGridRow">
            <Setter Property="Theme" Value="{StaticResource ReceiveAddressesViewTreeDataGridRow}" />
            <Setter Property="ContextMenu" Value="{StaticResource AddressContextMenu}" />
          </Style>
        </TreeDataGrid.Styles>
      </TreeDataGrid>
      <TextBlock Text="No address is awaiting a payment. Give each address to one payer only: payments to the same address are linked to each other."
                 IsVisible="{Binding !HasAddresses}" Opacity="0.6" TextWrapping="Wrap"
                 HorizontalAlignment="Left" VerticalAlignment="Top" />
    </Panel>
  </DockPanel>
</UserControl>
