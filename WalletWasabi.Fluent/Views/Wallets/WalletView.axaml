<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wallets="clr-namespace:WalletWasabi.Fluent.ViewModels.Wallets"
             xmlns:tabs="clr-namespace:WalletWasabi.Fluent.ViewModels.Wallets.Tabs"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="850"
             x:DataType="wallets:WalletViewModel"
             x:CompileBindings="True"
             ClipToBounds="False"
             x:Class="WalletWasabi.Fluent.Views.Wallets.WalletView">
  <!-- The page has no title: the title bar names the tab that it shows. -->
  <ContentArea ScrollViewer.VerticalScrollBarVisibility="Disabled" ClipToBounds="False" Classes="NoHeader">
    <!-- Every tab has its page all the time, and the one of the selected tab shows. A page that is left keeps what
         was typed into it and where it was scrolled to. -->
    <ItemsControl ItemsSource="{Binding Tabs}" ClipToBounds="False">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Panel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.Styles>
        <Style Selector="ItemsControl > ContentPresenter" x:DataType="tabs:WalletTabViewModel">
          <Setter Property="IsVisible" Value="{Binding IsSelected}" />
        </Style>
      </ItemsControl.Styles>
    </ItemsControl>
  </ContentArea>
</UserControl>
