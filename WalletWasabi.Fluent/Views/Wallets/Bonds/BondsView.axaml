<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WalletWasabi.Fluent.ViewModels.Wallets.Bonds"
             x:DataType="vm:BondsViewModel"
             x:CompileBindings="True"
             x:Class="WalletWasabi.Fluent.Views.Wallets.Bonds.BondsView">
  <ContentArea Title="{Binding Title}"
               Caption="Coins that are locked until the chain reaches a block height. Nothing can spend them before, this wallet included. A new bond locks the coins that are ticked on the Coins tab."
               EnableBack="{Binding EnableBack}"
               EnableCancel="{Binding EnableCancel}" CancelContent="Close"
               EnableNext="True" NextContent="New Bond"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
    <ContentArea.TopContent>
      <!-- What the bonds hold that are not redeemed yet. It is part of the balance of the wallet. -->
      <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right" VerticalAlignment="Center" Classes="h8" Opacity="0.6"
                  IsVisible="{Binding LockedAmount, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="In bonds:" Margin="0 1 0 0" />
        <AmountControl Amount="{Binding LockedAmount}" />
      </StackPanel>
    </ContentArea.TopContent>

    <StackPanel Spacing="10" Margin="0 0 20 0">
      <InfoMessage Foreground="{DynamicResource WarningMessageForeground}"
                   IsVisible="{Binding !IsChainHeightKnown}">
        <TextBlock Text="The Bitcoin node does not answer. Without it the wallet cannot tell which bonds are unlocked." TextWrapping="Wrap" />
      </InfoMessage>

      <TextBlock Text="The wallet has no fidelity bonds." Opacity="0.6" HorizontalAlignment="Center" Margin="0 60 0 0"
                 IsVisible="{Binding !HasBonds}" />

      <ItemsControl ItemsSource="{Binding Bonds}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:BondItemViewModel">
            <Border Background="{DynamicResource Layer2BackgroundBrush}" CornerRadius="4" Padding="16 12" Margin="0 0 0 8"
                    Classes.over="{Binding IsOver}">
              <Border.Styles>
                <Style Selector="Border.over">
                  <Setter Property="Opacity" Value="0.5" />
                </Style>
              </Border.Styles>
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="function" Margin="16 0 0 0" VerticalAlignment="Center"
                        Content="Redeem"
                        Command="{Binding RedeemCommand}"
                        IsVisible="{Binding IsRedeemable}"
                        ToolTip.Tip="Pay the coins of the bond back to the wallet." />
                <StackPanel Spacing="6">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" VerticalAlignment="Center" />
                    <AmountControl Amount="{Binding Amount}" HorizontalAlignment="Left" />
                  </DockPanel>
                  <TextBlock Text="{Binding HeightText}" Opacity="0.6" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding ValueText, StringFormat='Bond value: {0}'}" Opacity="0.6"
                             Background="Transparent"
                             IsVisible="{Binding ValueText, Converter={x:Static ObjectConverters.IsNotNull}}"
                             ToolTip.Tip="What the bond counts for, by the formula of JoinMarket with the time counted in blocks: the more coins and the more blocks they were locked for, the more. The number has no unit. It only compares bonds." />
                  <PreviewItem CopyableContent="{Binding Address}">
                    <TextBlock Text="{Binding Address}" Classes="monoSpaced" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                  </PreviewItem>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ContentArea>
</UserControl>
