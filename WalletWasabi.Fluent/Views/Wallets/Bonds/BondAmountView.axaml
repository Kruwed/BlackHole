<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WalletWasabi.Fluent.ViewModels.Wallets.Bonds"
             x:DataType="vm:BondAmountViewModel"
             x:CompileBindings="True"
             x:Class="WalletWasabi.Fluent.Views.Wallets.Bonds.BondAmountView">
  <ContentArea Title="{Binding Title}"
               Caption="{Binding UnlockText}"
               EnableBack="{Binding EnableBack}"
               EnableCancel="{Binding EnableCancel}"
               EnableNext="True" NextContent="Continue"
               IsBusy="{Binding IsBusy}"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
    <Interaction.Behaviors>
      <KeyDownTrigger Key="Enter" EventRoutingStrategy="Bubble" MarkAsHandled="False">
        <InvokeCommandAction Command="{Binding NextCommand}" />
      </KeyDownTrigger>
    </Interaction.Behaviors>
    <ContentArea.TopContent>
      <!-- What the picked coins hold -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Classes="h8" Opacity="0.6" Orientation="Horizontal" Spacing="5">
        <TextBlock Text="Max:" Margin="0 1 0 0" />
        <Button Focusable="False" Classes="plainHyperlink h8" Command="{Binding InsertMaxCommand}">
          <AmountControl Amount="{Binding Balance}" />
        </Button>
      </StackPanel>
    </ContentArea.TopContent>
    <StackPanel Spacing="18" Margin="0 0 12 0">
      <DockPanel>
        <Label DockPanel.Dock="Left" Content="_Amount:" Target="amountTb" MinWidth="80" />
        <AmountEntryBox x:Name="amountTb"
                        AmountBtc="{Binding AmountBtc}"
                        CurrencyCode="BTC"
                        BalanceBtc="{Binding Balance.Btc}"
                        ValidatePasteBalance="False">
          <Interaction.Behaviors>
            <FocusOnAttachedBehavior />
          </Interaction.Behaviors>
        </AmountEntryBox>
      </DockPanel>

      <PreviewItem Icon="{StaticResource transceive_regular}"
                   Label="Address of the bond"
                   CopyableContent="{Binding Address}">
        <TextBlock Text="{Binding Address}" Classes="monoSpaced" TextWrapping="Wrap" />
      </PreviewItem>

      <TextBlock TextWrapping="Wrap" Opacity="0.8"
                 Text="What you lock here cannot be spent before that date. If you lock all of the picked coins, the mining fee is taken from the bond." />
    </StackPanel>
  </ContentArea>
</UserControl>
