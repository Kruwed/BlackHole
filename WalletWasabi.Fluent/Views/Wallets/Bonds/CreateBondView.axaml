<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WalletWasabi.Fluent.ViewModels.Wallets.Bonds"
             x:DataType="vm:CreateBondViewModel"
             x:CompileBindings="True"
             x:Class="WalletWasabi.Fluent.Views.Wallets.Bonds.CreateBondView">
  <ContentArea Title="{Binding Title}"
               Caption="Name the block height that the coins are locked until. The coins are the ones that are ticked on the Coins tab."
               EnableBack="{Binding EnableBack}"
               EnableCancel="{Binding EnableCancel}"
               EnableNext="True" NextContent="Continue"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="18" Margin="0 0 20 0">

      <!-- The bond unlocks when the chain has reached this height, whenever that is. -->
      <DockPanel>
        <Label DockPanel.Dock="Left" Content="_Unlock height:" Target="HeightBox" MinWidth="120" VerticalAlignment="Top" Margin="0 8 0 0" />
        <StackPanel Spacing="6">
          <TextBox Name="HeightBox" Text="{Binding UnlockHeightText}" Watermark="Block height" MaxLength="12" Width="380" HorizontalAlignment="Left">
            <Interaction.Behaviors>
              <FocusOnAttachedBehavior />
            </Interaction.Behaviors>
          </TextBox>
          <TextBlock Text="{Binding ChainText}" Opacity="0.6" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>

      <!-- The day that the chain is expected to get there. -->
      <TextBlock Text="{Binding LockText}" TextWrapping="Wrap"
                 IsVisible="{Binding LockText, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <PreviewItem Icon="{StaticResource transceive_regular}"
                   Label="Address of the bond"
                   CopyableContent="{Binding Address}"
                   IsVisible="{Binding Address, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding Address}" Classes="monoSpaced" TextWrapping="Wrap" />
      </PreviewItem>

      <Separator />

      <StackPanel Spacing="8" Opacity="0.8">
        <TextBlock TextWrapping="Wrap" Text="• Coins in a bond cannot be spent before the chain has reached that height. There is no way to undo it." />
        <TextBlock TextWrapping="Wrap" Text="• The date is an estimation. Blocks come every ten minutes on average, sometimes faster and sometimes slower." />
        <TextBlock TextWrapping="Wrap" Text="• Every payment to the address is a bond of its own. Pay to it once: several small bonds count for less than one." />
        <TextBlock TextWrapping="Wrap" Text="• The recovery words of the wallet restore its bonds too." />
        <TextBlock TextWrapping="Wrap" Text="• A bond that is shown to others is public, and with it the history of the coins that it holds." />
      </StackPanel>

      <TextBlock TextWrapping="Wrap" Opacity="0.6"
                 Text="The address can be paid from another wallet too. Such a bond is listed once its transaction is confirmed."
                 IsVisible="{Binding Address, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <!-- Which coins the bond locks, or what is to be done first if none is ticked. -->
      <TextBlock TextWrapping="Wrap" Opacity="0.6" Text="{Binding CoinsText}" />
    </StackPanel>
  </ContentArea>
</UserControl>
