<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wallets="clr-namespace:WalletWasabi.Fluent.ViewModels.Wallets"
             x:DataType="wallets:CoinJoinBoxViewModel"
             x:CompileBindings="True"
             x:Class="WalletWasabi.Fluent.Views.Wallets.CoinJoinBoxView">
  <UserControl.Styles>
    <Style Selector="Border#Box :is(TextBlock)">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border#Box Button:disabled PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource TextControlForegroundDisabled}" />
    </Style>
    <!-- The box is right above the buttons of its dialog. Its tool tips open upwards, so that they do not cover them. -->
    <Style Selector="Border#Box Button">
      <Setter Property="ToolTip.Placement" Value="Top" />
      <Setter Property="ToolTip.VerticalOffset" Value="-4" />
    </Style>
  </UserControl.Styles>

  <!-- The coinjoins: the kind that the box is set to, what its coinjoin is doing, and its controls. The menu lists the
       kinds, and it leads to the offer of the wallet as a market maker and to its fidelity bonds. -->
  <Border Name="Box" ClipToBounds="True"
          TextElement.FontFamily="{StaticResource MonospacedFont}"
          CornerRadius="4"
          BorderBrush="{DynamicResource GlassEdgeColor}"
          BorderThickness="1">
    <Panel>
      <Panel Background="{DynamicResource TileRegionColor}" Opacity="0.35" />
      <DockPanel Margin="10 8">

        <!-- Which kind it is -->
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Spacing="2" MinWidth="58" Margin="0 0 20 0">
          <Image Height="35" Width="35" HorizontalAlignment="Center" Source="{DynamicResource app_logo_dynamic}" />
          <TextBlock Text="{Binding Name}" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- The kinds of coinjoin, and what else is done with the ticked coins. The box is at the bottom of its dialog,
             so the menu opens upwards. -->
        <Button DockPanel.Dock="Right" Classes="plain" Margin="20 0 0 0" ToolTip.Tip="Kinds of coinjoin, and more">
          <Button.Flyout>
            <MenuFlyout Placement="TopEdgeAlignedRight">
              <MenuItem Header="{Binding WabiSabi.Name}" Command="{Binding WabiSabi.SelectCommand}">
                <MenuItem.Icon>
                  <PathIcon Data="{StaticResource checkmark_filled}" IsVisible="{Binding WabiSabi.IsSelected}" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{Binding ZeroLink.Name}" Command="{Binding ZeroLink.SelectCommand}">
                <MenuItem.Icon>
                  <PathIcon Data="{StaticResource checkmark_filled}" IsVisible="{Binding ZeroLink.IsSelected}" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{Binding Taker.Name}" Command="{Binding Taker.SelectCommand}">
                <MenuItem.Icon>
                  <PathIcon Data="{StaticResource checkmark_filled}" IsVisible="{Binding Taker.IsSelected}" />
                </MenuItem.Icon>
              </MenuItem>
              <Separator />
              <MenuItem Header="Maker" Command="{Binding MakerCommand}">
                <MenuItem.Icon>
                  <PathIcon Data="{StaticResource wallet_action_offer}" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Bond" Command="{Binding BondCommand}">
                <MenuItem.Icon>
                  <PathIcon Data="{StaticResource wallet_action_bond}" />
                </MenuItem.Icon>
              </MenuItem>
              <Separator />
              <MenuItem Header="Coordinator Settings" Command="{Binding CoordinatorSettingsCommand}">
                <MenuItem.Icon>
                  <PathIcon Data="{StaticResource coordinator}" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Coinjoin Payments" Command="{Binding CoinJoinPaymentsCommand}"
                        IsVisible="{Binding IsCoinJoinEnabled}">
                <MenuItem.Icon>
                  <PathIcon Data="{StaticResource embedded_payment}" />
                </MenuItem.Icon>
              </MenuItem>
            </MenuFlyout>
          </Button.Flyout>
          <PathIcon Data="{StaticResource more_regular}" Opacity="0.6" />
        </Button>

        <!-- Play and Stop, in one place. A kind that has no coinjoin to start shows a Play that cannot be pressed,
             and its tool tip tells why. -->
        <Panel DockPanel.Dock="Right" Margin="20 0 0 0" VerticalAlignment="Center">
          <Button Classes="plain"
                  IsVisible="{Binding State.PlayVisible, FallbackValue=False}"
                  Command="{Binding State.PlayCommand}"
                  ToolTip.Tip="{Binding State.PlayToolTip}"
                  ToolTip.ShowOnDisabled="True">
            <PathIcon Data="{StaticResource play_regular}" />
          </Button>

          <Button Classes="plain"
                  IsVisible="{Binding State.StopVisible, FallbackValue=False}"
                  Command="{Binding State.StopCommand}"
                  ToolTip.Tip="Stop coinjoin">
            <PathIcon Data="{StaticResource stop_regular}" />
          </Button>

          <Button Classes="plain" IsEnabled="False"
                  IsVisible="{Binding State, Converter={x:Static ObjectConverters.IsNull}}"
                  ToolTip.Tip="{Binding NoPlayToolTip}"
                  ToolTip.ShowOnDisabled="True">
            <PathIcon Data="{StaticResource play_regular}" />
          </Button>
        </Panel>

        <Separator DockPanel.Dock="Right" Classes="vertical" Margin="20 0 0 0" />

        <Panel VerticalAlignment="Center" MinHeight="58">

          <!-- What the coinjoin of the kind is doing -->
          <StackPanel Spacing="5" VerticalAlignment="Center"
                      IsVisible="{Binding State, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TransitioningContentControl MinHeight="18" Content="{Binding State.CurrentStatus}">
              <TransitioningContentControl.PageTransition>
                <PageSlide Duration="0:0:0.125" Orientation="Vertical" SlideInEasing="0.4,0,0.6,1" SlideOutEasing="0.4,0,0.6,1" />
              </TransitioningContentControl.PageTransition>
              <TransitioningContentControl.DataTemplates>
                <DataTemplate DataType="x:String">
                  <TextBlock Text="{Binding .}" />
                </DataTemplate>
              </TransitioningContentControl.DataTemplates>
            </TransitioningContentControl>

            <ProgressBar Minimum="0" Maximum="100" IsIndeterminate="{Binding State.IsCountDownDelayHappening, FallbackValue=False}" Value="{Binding State.ProgressValue, FallbackValue=0}">
              <ProgressBar.Foreground>
                <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.4" />
              </ProgressBar.Foreground>
              <ProgressBar.Background>
                <SolidColorBrush Color="{DynamicResource SystemBaseMediumColor}" Opacity="0.5" />
              </ProgressBar.Background>
            </ProgressBar>

            <DockPanel LastChildFill="False">
              <TextBlock Text="{Binding State.LeftText}" DockPanel.Dock="Left" />
              <TextBlock Text="{Binding State.RightText}" DockPanel.Dock="Right" />
            </DockPanel>
          </StackPanel>

          <!-- The kind has no coinjoin to show: what is missing -->
          <StackPanel Spacing="4" VerticalAlignment="Center"
                      IsVisible="{Binding State, Converter={x:Static ObjectConverters.IsNull}}">
            <TextBlock Text="{Binding Notice}" />
            <TextBlock Text="{Binding NoticeDetail}"
                       IsVisible="{Binding NoticeDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Panel>
      </DockPanel>
    </Panel>
  </Border>
</UserControl>
