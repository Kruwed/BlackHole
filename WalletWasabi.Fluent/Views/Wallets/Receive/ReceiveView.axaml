<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:receive="clr-namespace:WalletWasabi.Fluent.ViewModels.Wallets.Receive"
             x:DataType="receive:ReceiveViewModel"
             x:CompileBindings="True"
             x:Class="WalletWasabi.Fluent.Views.Wallets.Receive.ReceiveView">

  <UserControl.Resources>
    <!-- What a right click on an address of the list offers. -->
    <ContextMenu x:Key="AddressContextMenu" x:DataType="receive:AddressViewModel">
      <MenuItem Header="Copy Bitcoin Address" Command="{Binding CopyAddressCommand}">
        <MenuItem.Icon>
          <PathIcon Data="{StaticResource btc_logo}" />
        </MenuItem.Icon>
      </MenuItem>
    </ContextMenu>
  </UserControl.Resources>

  <ContentArea Title="{Binding Title}"
               Caption="The addresses that were generated and have not been paid to yet. Give each address to one payer only: payments to the same address are linked to each other."
               EnableBack="{Binding EnableBack}"
               EnableCancel="{Binding EnableCancel}" CancelContent="Close"
               ScrollViewer.VerticalScrollBarVisibility="Disabled"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ContentArea.TopContent>
      <!-- The button for a new address, at the right end of the title -->
      <Button Classes="function" Command="{Binding GenerateCommand}"
              HorizontalAlignment="Right" VerticalAlignment="Center"
              ToolTip.Tip="Generates an address that was not given out before and shows it.">
        <StackPanel Orientation="Horizontal">
          <PathIcon Data="{StaticResource wallet_action_receive}" />
          <TextBlock Text="New Address" />
        </StackPanel>
      </Button>
    </ContentArea.TopContent>

    <Panel>
      <TreeDataGrid Source="{Binding Source}" VerticalAlignment="Stretch" IsVisible="{Binding HasAddresses}">
        <Interaction.Behaviors>
          <TreeDataGridMissingCellsWorkaroundBehavior />
        </Interaction.Behaviors>
        <TreeDataGrid.Styles>
          <Style Selector="TreeDataGridRow">
            <Setter Property="Theme" Value="{StaticResource ReceiveAddressesViewTreeDataGridRow}" />
            <Setter Property="ContextMenu" Value="{StaticResource AddressContextMenu}" />
          </Style>
        </TreeDataGrid.Styles>
      </TreeDataGrid>
      <TextBlock Text="No address is awaiting a payment."
                 IsVisible="{Binding !HasAddresses}" Opacity="0.6" TextWrapping="Wrap"
                 HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 60 0 0" />
    </Panel>
  </ContentArea>
</UserControl>
