<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:market="using:WalletWasabi.Fluent.ViewModels.Wallets.Market"
             xmlns:v="using:WalletWasabi.Fluent.Views.Wallets.Market"
             x:DataType="market:MakerScreenViewModel"
             x:CompileBindings="True"
             x:Class="WalletWasabi.Fluent.Views.Wallets.Market.MakerScreenView">

  <!-- The accent of the maker's side is blue. -->
  <UserControl.Resources>
    <SolidColorBrush x:Key="MarketAccentBrush" Color="#4d8dff" />
    <SolidColorBrush x:Key="MarketAccentFillBrush" Color="#0f2652" />
    <SolidColorBrush x:Key="MarketDividerBrush" Color="#524d8dff" />
  </UserControl.Resources>

  <UserControl.Styles>
    <StyleInclude Source="avares://WalletWasabi.Fluent/Views/Wallets/Market/MarketStyles.axaml" />
    <Style Selector="ListBox.marketList ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="ListBox.marketList ListBoxItem /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- A field of a form: its name, the box, and its unit. -->
    <Style Selector="Grid.marketField > TextBlock.marketLabel">
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!-- A line of a card: a name on the left and what it is on the right. -->
    <Style Selector="Grid.marketLine > TextBlock.value">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="FontFeatures" Value="+tnum" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- What marks a picked coin: yellow if it has no points, red if a larger picked coin has the same origin, orange beyond the first three. -->
    <Style Selector="Grid.noPoints TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MarketWarnBrush}" />
    </Style>
    <Style Selector="Grid.sharedOrigin TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MarketSellBrush}" />
    </Style>
    <Style Selector="Grid.extra TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MarketExtraBrush}" />
    </Style>
    <Style Selector="Grid.barredRow">
      <Setter Property="Opacity" Value="0.38" />
    </Style>
  </UserControl.Styles>

  <!-- Three columns: the strategy with the split of the wallet and the rates of the offer, the coins of the wallet,
       and the two things that a maker does with them. Below a width that the three need, the screen scrolls sideways. -->
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <!-- The grid is as wide as the place that it has, and not narrower than its columns need. Its width is said
         outright: what scrolls sideways would otherwise be laid out as if it had all the room in the world, and
         a text that wraps would be given the height of one line. -->
    <Grid MinWidth="1302" Width="{Binding $parent[ScrollViewer].Bounds.Width}">
      <!-- The side columns are as wide as their design where there is room, and give some of it up where there is not. -->
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="340" MaxWidth="380" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="2*" MinWidth="620" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" MinWidth="340" MaxWidth="380" />
      </Grid.ColumnDefinitions>

      <!-- The strategy triangle. Under it, the split of the wallet, which is live on Lock Coins, and the rates of the
           offer, which are live on List Offers. -->
      <DockPanel Grid.Column="0">
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0 4 0 0">
          <StrategyTriangleControl Weights="{Binding Strategy, Mode=TwoWay}"
                                   TopLabel="{Binding TopName}" LeftLabel="{Binding LeftName}" RightLabel="{Binding RightName}"
                                   Accent="{DynamicResource MarketAccentBrush}"
                                   Stroke="{DynamicResource MarketDividerBrush}"
                                   Fill="{DynamicResource Layer1BackgroundBrush}"
                                   Foreground="{DynamicResource TextControlForeground}"
                                   DimForeground="#818899"
                                   MaxWidth="340" HorizontalAlignment="Center"
                                   ToolTip.Tip="Click or drag to set the offer and the split of the wallet by a strategy. The arrow keys move the marker as well." />
          <TextBlock Text="{Binding StrategyText}" FontSize="11" Opacity="0.5" MinHeight="16" HorizontalAlignment="Center" FontFeatures="+tnum" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="20 14 20 18" Spacing="14">
            <ItemsControl ItemsSource="{Binding AllocationRows}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="14" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="market:BarRowViewModel">
                  <v:BarRowView />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding RateRows}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="14" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="market:BarRowViewModel">
                  <v:BarRowView />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>

      <Border Grid.Column="1" Classes="marketDivider" />

      <!-- The coins of the wallet. A coin that is locked in a bond sits on top, with a padlock and the blocks that it is still locked for. -->
      <DockPanel Grid.Column="2">
        <Border DockPanel.Dock="Top" BorderThickness="0 0 0 1" BorderBrush="{DynamicResource MarketDividerBrush}">
          <Grid ColumnDefinitions="64,*,150,150" Height="36" Margin="14 0 14 0">
            <Button Grid.Column="0" Theme="{StaticResource MarketHeaderButton}" Classes="active" Command="{Binding ToggleAllCommand}" HorizontalContentAlignment="Left"
                    ToolTip.Tip="Select all / none">
              <Border Classes="marketTick" Classes.ticked="{Binding IsAnySelected}">
                <Panel>
                  <PathIcon Data="{StaticResource checkmark_filled}" IsVisible="{Binding IsAllSelected}" />
                  <PathIcon Data="{StaticResource market_dash}" IsVisible="{Binding IsSomeSelected}" />
                </Panel>
              </Border>
            </Button>
            <Button Grid.Column="1" Theme="{StaticResource MarketHeaderButton}" Classes="active" Command="{Binding ToggleAddressesCommand}"
                    HorizontalContentAlignment="Left" Content="{Binding ReferenceHeader}"
                    ToolTip.Tip="Switch between outpoint and address" />
            <Button Grid.Column="2" Theme="{StaticResource MarketHeaderButton}" Command="{Binding SortByPointsCommand}" Content="Anonymity Points"
                    Classes.active="{Binding IsSortedByPoints}" />
            <Button Grid.Column="3" Theme="{StaticResource MarketHeaderButton}" Command="{Binding SortByAmountCommand}"
                    Classes.active="{Binding IsSortedByAmount}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Amount" />
                <TextBlock Classes="marketUnit" Text="BTC" FontSize="10" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <ListBox Classes="marketList" ItemsSource="{Binding Coins}" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="market:MakerCoinRowViewModel">
              <Button Theme="{StaticResource MarketRowButton}" Command="{Binding ToggleCommand}" CommandParameter="{Binding Id}"
                      Classes.selected="{Binding IsSelected}" Classes.barred="{Binding !CanToggle}">
                <Grid ColumnDefinitions="64,*,150,150" Height="38" Margin="14 0 14 0"
                      Classes.noPoints="{Binding HasNoPoints}" Classes.sharedOrigin="{Binding IsSharedOrigin}" Classes.extra="{Binding IsExtra}"
                      Classes.barredRow="{Binding IsBarred}">
                  <Border Grid.Column="0" Classes="marketTick" Classes.ticked="{Binding IsSelected}" Classes.dim="{Binding IsTaken}" IsVisible="{Binding IsFree}">
                    <PathIcon Data="{StaticResource checkmark_filled}" IsVisible="{Binding IsSelected}" />
                  </Border>
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Opacity="0.6" IsVisible="{Binding IsBond}"
                              ToolTip.Tip="Locked in a fidelity bond. The number is how many blocks it is still locked for.">
                    <PathIcon Data="{StaticResource market_padlock}" Width="14" Height="14" />
                    <TextBlock Text="{Binding LockText}" FontSize="11" VerticalAlignment="Center" FontFeatures="+tnum" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Classes="monoSpaced" FontSize="12" VerticalAlignment="Center" Text="{Binding Reference}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Classes="marketCell" Text="{Binding Points}" />
                  <TextBlock Grid.Column="3" Classes="marketCell" Text="{Binding Amount}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <Border Grid.Column="3" Classes="marketDivider" />

      <!-- Lock Coins, and List Offers. -->
      <DockPanel Grid.Column="4">
        <Border DockPanel.Dock="Top" BorderThickness="0 0 0 1" BorderBrush="{DynamicResource MarketDividerBrush}">
          <Grid ColumnDefinitions="*,*">
            <Button Grid.Column="0" Theme="{StaticResource MarketTabButton}" Content="Lock Coins"
                    Command="{Binding ShowBondCommand}" Classes.active="{Binding IsBondTab}" />
            <Button Grid.Column="1" Theme="{StaticResource MarketTabButton}" Content="List Offers"
                    Command="{Binding ShowOffersCommand}" Classes.active="{Binding IsOffersTab}" />
          </Grid>
        </Border>

        <Panel>
          <!-- Lock Coins. With a bond, what there is to tell about it. Without one, the form that locks one. -->
          <ScrollViewer IsVisible="{Binding IsBondTab}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Panel Margin="20 18 20 18">
              <ItemsControl ItemsSource="{Binding Bonds}" IsVisible="{Binding HasBond}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="22" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="market:BondCardViewModel">
                    <StackPanel Spacing="12">
                      <Grid Classes="marketLine" ColumnDefinitions="96,*">
                        <TextBlock Classes="marketLabel" Text="AMOUNT" />
                        <TextBlock Grid.Column="1" Classes="value" Text="{Binding Amount}" />
                      </Grid>
                      <Grid Classes="marketLine" ColumnDefinitions="96,*">
                        <TextBlock Classes="marketLabel" Text="LOCKED FOR" />
                        <TextBlock Grid.Column="1" Classes="value" Text="{Binding LockedFor}" />
                      </Grid>
                      <Grid Classes="marketLine" ColumnDefinitions="96,*">
                        <TextBlock Classes="marketLabel" Text="UNLOCK TIME" />
                        <TextBlock Grid.Column="1" Classes="value" Text="{Binding UnlockTime}" />
                      </Grid>
                      <Grid Classes="marketLine" ColumnDefinitions="96,*">
                        <TextBlock Classes="marketLabel" Text="RANK" />
                        <TextBlock Grid.Column="1" Classes="value" Text="{Binding Rank}" />
                      </Grid>
                      <Grid Classes="marketLine" ColumnDefinitions="96,*">
                        <TextBlock Classes="marketLabel" Text="PERCENTILE" />
                        <TextBlock Grid.Column="1" Classes="value" Text="{Binding Percentile}" />
                      </Grid>
                      <TextBlock Classes="marketMuted" FontSize="12" TextWrapping="Wrap" Text="{Binding Status}" IsVisible="{Binding HasStatus}" />
                      <Button Theme="{StaticResource MarketPrimaryButton}" Content="Redeem" HorizontalAlignment="Stretch"
                              Command="{Binding RedeemCommand}" CommandParameter="{Binding Bond}" IsVisible="{Binding CanRedeem}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Spacing="12" IsVisible="{Binding !HasBond}">
                <Grid Classes="marketField" ColumnDefinitions="72,*,60">
                  <TextBlock Classes="marketLabel" Text="AMOUNT" />
                  <TextBox Grid.Column="1" Classes="marketInput" Text="{Binding BondAmount}" MaxLength="20" />
                  <TextBlock Grid.Column="2" Classes="marketUnit" Text="BTC" Margin="12 0 0 0" />
                </Grid>
                <Grid Classes="marketField" ColumnDefinitions="72,*,60">
                  <TextBlock Classes="marketLabel" Text="LOCK TIME" />
                  <TextBox Grid.Column="1" Classes="marketInput" Text="{Binding BondBlocks}" MaxLength="9" />
                  <TextBlock Grid.Column="2" Classes="marketUnit" Text="blocks" Margin="12 0 0 0" />
                </Grid>
                <Grid Classes="marketField" ColumnDefinitions="72,*,60">
                  <TextBlock Classes="marketLabel" Text="FEE RATE" />
                  <TextBox Grid.Column="1" Classes="marketInput" Text="{Binding BondFeeRate}" MaxLength="12" />
                  <TextBlock Grid.Column="2" Classes="marketUnit" Text="sat/vByte" Margin="12 0 0 0" />
                </Grid>
                <Button Theme="{StaticResource MarketPrimaryButton}" Content="Bond" HorizontalAlignment="Stretch" Command="{Binding BondCommand}" />
                <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MarketSellBrush}"
                           Text="{Binding BondError}" IsVisible="{Binding HasBondError}" />
              </StackPanel>
            </Panel>
          </ScrollViewer>

          <!-- List Offers: the form of an offer, and below it a card for every offer that is posted. -->
          <ScrollViewer IsVisible="{Binding IsOffersTab}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20 18 20 18" Spacing="12">
              <Grid Classes="marketField" ColumnDefinitions="72,*,60">
                <TextBlock Classes="marketLabel" Text="AMOUNT" />
                <TextBox Grid.Column="1" Classes="marketInput" Text="{Binding OfferAmount}" MaxLength="20" />
                <TextBlock Grid.Column="2" Classes="marketUnit" Text="BTC" Margin="12 0 0 0" />
              </Grid>
              <Grid Classes="marketField" ColumnDefinitions="72,*,60">
                <TextBlock Classes="marketLabel" Text="FEE RATE" />
                <TextBox Grid.Column="1" Classes="marketInput" Text="{Binding OfferFeeRate}" MaxLength="12" />
                <TextBlock Grid.Column="2" Classes="marketUnit" Text="sat/vByte" Margin="12 0 0 0" />
              </Grid>
              <Grid Classes="marketField" ColumnDefinitions="72,*,60">
                <TextBlock Classes="marketLabel" Text="SELL RATE" />
                <TextBox Grid.Column="1" Classes="marketInput" Text="{Binding OfferSellRate}" MaxLength="12"
                         IsEnabled="{Binding IsSellRateEnabled}" />
                <TextBlock Grid.Column="2" Classes="marketUnit" Text="sats/AP" Margin="12 0 0 0" />
              </Grid>
              <Grid Classes="marketField" ColumnDefinitions="72,*,60">
                <TextBlock Classes="marketLabel" Text="BUY RATE" />
                <TextBox Grid.Column="1" Classes="marketInput" Text="{Binding OfferBuyRate}" MaxLength="12" />
                <TextBlock Grid.Column="2" Classes="marketUnit" Text="sats/AP" Margin="12 0 0 0" />
              </Grid>
              <!-- Why the sell rate is 0 and cannot be set, while the picked coins have no points to sell. -->
              <TextBlock Classes="marketMuted" FontSize="11.5" TextWrapping="Wrap"
                         Text="{Binding SellRateNote}"
                         IsVisible="{Binding SellRateNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <Button Theme="{StaticResource MarketPrimaryButton}" Content="{Binding OfferButtonText}" HorizontalAlignment="Stretch" Command="{Binding PostOfferCommand}" />
              <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MarketSellBrush}"
                         Text="{Binding OfferError}" IsVisible="{Binding HasOfferError}" />

              <ItemsControl ItemsSource="{Binding Offers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="market:OfferCardViewModel">
                    <Border BorderThickness="0 1 0 0" BorderBrush="{DynamicResource MarketDividerBrush}" Padding="0 14 0 0" Margin="0 4 0 12">
                      <StackPanel Spacing="6">
                        <DockPanel Margin="0 0 0 4">
                          <Button DockPanel.Dock="Right" Classes="plain" Content="Cancel" FontSize="11" Padding="10 3"
                                  Command="{Binding CancelCommand}" CommandParameter="{Binding Id}" Cursor="Hand" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Alias}" FontWeight="Medium" FontSize="12.5" VerticalAlignment="Center" />
                            <Border Classes="marketTag">
                              <TextBlock Text="{Binding Status}" />
                            </Border>
                          </StackPanel>
                        </DockPanel>
                        <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource MarketSellBrush}"
                                   Text="{Binding Problem}" IsVisible="{Binding HasProblem}" />
                        <Grid Classes="marketLine" ColumnDefinitions="72,*">
                          <TextBlock Classes="marketLabel" Text="COINS" />
                          <TextBlock Grid.Column="1" Classes="value" Text="{Binding Coins}" />
                        </Grid>
                        <Grid Classes="marketLine" ColumnDefinitions="72,*">
                          <TextBlock Classes="marketLabel" Text="AMOUNT" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                            <TextBlock FontSize="12.5" FontFeatures="+tnum" Text="{Binding Amount}" />
                            <TextBlock FontSize="12.5" FontFeatures="+tnum" Opacity="0.5" Text="/" />
                            <TextBlock FontSize="12.5" FontFeatures="+tnum" Opacity="0.5" Text="{Binding Total}" />
                            <TextBlock FontSize="12.5" Text="BTC" />
                          </StackPanel>
                        </Grid>
                        <Grid Classes="marketLine" ColumnDefinitions="72,*">
                          <TextBlock Classes="marketLabel" Text="AP" />
                          <TextBlock Grid.Column="1" Classes="value" Text="{Binding Points}" />
                        </Grid>
                        <Grid Classes="marketLine" ColumnDefinitions="72,*">
                          <TextBlock Classes="marketLabel" Text="FEE RATE" />
                          <TextBlock Grid.Column="1" Classes="value" Text="{Binding FeeRate}" />
                        </Grid>
                        <Grid Classes="marketLine" ColumnDefinitions="72,*">
                          <TextBlock Classes="marketLabel" Text="SPREAD" />
                          <TextBlock Grid.Column="1" Classes="value" Text="{Binding Spread}" />
                        </Grid>
                        <Grid Classes="marketLine" ColumnDefinitions="72,*">
                          <TextBlock Classes="marketLabel" Text="SELL RATE" />
                          <TextBlock Grid.Column="1" Classes="value" Text="{Binding SellRate}" />
                        </Grid>
                        <Grid Classes="marketLine" ColumnDefinitions="72,*">
                          <TextBlock Classes="marketLabel" Text="BUY RATE" />
                          <TextBlock Grid.Column="1" Classes="value" Text="{Binding BuyRate}" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Panel>
      </DockPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
