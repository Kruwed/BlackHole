<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<NoWarn>1701;1702;1705;1591;1573;CA1031;CA1822</NoWarn>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
		<DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
		<PathMap>$(MSBuildProjectDirectory)\=WalletWasabi.Daemon</PathMap>
		<OutputType>Exe</OutputType>
		<RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
	</PropertyGroup>

	<PropertyGroup>
		<NeutralLanguage>en-US</NeutralLanguage>
		<AssemblyTitle>Black Hole Daemon</AssemblyTitle>
		<Description>
			Open-source, non-custodial, privacy focused Bitcoin wallet for Linux that talks only to the user's Bitcoin node. Built-in Tor, coinjoin, and coin control features. A fork of Wasabi Wallet.
		</Description>
		<Copyright>MIT</Copyright>
		<PackageId>WalletWasabi.Daemon</PackageId>
		<PackageTags>bitcoin-wallet;privacy;bitcoin;dotnet;nbitcoin;cross-platform;zerolink;wallet;wabisabi;coinjoin;tor</PackageTags>
		<PackageProjectUrl>https://github.com/Kruwed/BlackHole/</PackageProjectUrl>
		<PackageLicenseUrl>https://github.com/Kruwed/BlackHole/blob/master/LICENSE.md</PackageLicenseUrl>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/Kruwed/BlackHole/</RepositoryUrl>
		<Product>Black Hole Daemon</Product>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\WalletWasabi.Client\WalletWasabi.Client.csproj" />
	</ItemGroup>

</Project>
